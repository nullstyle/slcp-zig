        "traversalLimitWords": 32,
        "nestingLimit": 32
      },
      "expectedAccepted": false,
      "zigDiagnostic": "InvalidFlatBytes",
      "note": ""
    },
    {
      "id": "non-word-aligned-flat",
      "encoding": "flat",
      "bytes": "00",
      "options": {
        "traversalLimitWords": 32,
        "nestingLimit": 32
      },
      "expectedAccepted": false,
      "zigDiagnostic": "InvalidFlatBytes",
      "note": "SLCP flat entry point requires at least one complete word."
    },
